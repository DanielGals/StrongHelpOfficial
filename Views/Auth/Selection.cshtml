@{
    ViewData["Title"] = "Choose Your Portal Access";
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/Selection.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>

    <div class="portal-selection-container">
        <div class="welcome-text">
            <h1>Welcome back!</h1>
        </div>
        <h1 class="portal-selection-title">Choose Your Portal Access</h1>

        <div class="portal-cards-container">
            <!-- Employee Portal Card -->
            <div class="portal-card">
                <div class="portal-icon borrower-icon">
                    <i class="bi bi-person"></i>
                </div>
                <h2 class="portal-title borrower-title">Employee Portal</h2>
                <p class="portal-description">Apply for loans, track your applications, and manage your account</p>
                <a href="@Url.Action("Index", "LoanerDashboard", new { area = "Loaner" })"
                    class="portal-button borrower-button">Go to Employee Portal</a>
            </div>

            <!-- Approver/Admin Portal Card -->
            @{
                string roleName = Context.Session.GetString("RoleName") ?? "";
                string portalTitle = "Approver Portal";
                string portalDescription = "Review and approve loan applications, access reports and analytics";
                string buttonText = "Go to Approver Portal";
                string approverAction = "";

                if (roleName == "Benefits Assistant")
                {
                    approverAction = Url.Action("Index", "BenefitsAssistantDashboard");
                }
                else if (roleName == "Admin")
                {
                    portalTitle = "Admin Portal";
                    portalDescription = "Manage users, roles, departments, and system settings";
                    buttonText = "Go to Admin Portal";
                    approverAction = Url.Action("Index", "AdminDashboard");
                }
                else
                {
                    approverAction = Url.Action("Index", "ApproverDashboard");
                }
            }
            <div class="portal-card">
                <div class="portal-icon approver-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h2 class="portal-title approver-title">@portalTitle</h2>
                <p class="portal-description">@portalDescription</p>
                <a href="@approverAction" class="portal-button approver-button">@buttonText</a>
            </div>
        </div>
    </div>

    <!-- Add Bootstrap Icons if not already included in layout -->
</body>

</html>